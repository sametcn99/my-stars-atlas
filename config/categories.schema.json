{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Stars Atlas Categories",
	"description": "Seed category taxonomy offered to Jev as choice options during classification.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string",
			"const": "./categories.schema.json",
			"description": "Relative path to this schema file so editors can validate config/categories.json.",
			"examples": ["./categories.schema.json"]
		},
		"recentCount": {
			"type": "integer",
			"minimum": 1,
			"description": "How many most-recently starred repositories to surface in the generated outputs."
		},
		"defaultCategory": {
			"$ref": "#/$defs/categoryId"
		},
		"categories": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/categoryDefinition"
			},
			"description": "Seed categories in display order; the array position decides where a category appears in the generated outputs."
		}
	},
	"required": ["$schema", "recentCount", "defaultCategory", "categories"],
	"$defs": {
		"categoryId": {
			"type": "string",
			"enum": [
				"ai",
				"ai-harness",
				"editor-tooling",
				"developer-tools",
				"browser-extensions",
				"design-systems",
				"frontend",
				"content-cms",
				"cloud",
				"backend",
				"desktop",
				"media",
				"devops",
				"databases",
				"data",
				"data-visualization",
				"dotnet",
				"mobile",
				"automation",
				"security",
				"design",
				"libraries",
				"cli",
				"learning",
				"misc"
			]
		},
		"trimmedString": {
			"type": "string",
			"minLength": 1,
			"pattern": ".*\\S.*"
		},
		"categoryDefinition": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"id": {
					"$ref": "#/$defs/categoryId"
				},
				"title": {
					"$ref": "#/$defs/trimmedString"
				},
				"description": {
					"$ref": "#/$defs/trimmedString",
					"description": "Sent to Jev verbatim as this option's criteria, so it should describe what belongs here."
				}
			},
			"required": ["id", "title", "description"]
		}
	}
}
