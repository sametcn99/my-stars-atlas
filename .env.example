# Copy to .env and fill in the values. .env is gitignored; never commit real keys.

# Required. OpenRouter key used for every Jev classification call.
# Create one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Raises the GitHub API rate limit while fetching stars and READMEs.
# GH_TOKEN works as an alias.
GITHUB_TOKEN=

# Optional. Same as the --force flag: skip the star count pre-check and refetch everything.
# FORCE_REFRESH=false

# Optional. Same as the --no-cache flag: ignore .cache and reclassify every repository.
# NO_CACHE=false
