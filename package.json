{
	"name": "my-stars",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "bun run update && vite build --config vite.config.ts",
		"update": "bun run src/index.ts",
		"preview": "vite preview --config vite.config.ts",
		"typecheck": "bunx tsc --noEmit",
		"check": "bun run typecheck && bunx --bun @biomejs/biome check --write ."
	},
	"dependencies": {
		"@tanstack/react-virtual": "^3.14.9",
		"@vitejs/plugin-react": "latest",
		"react": "latest",
		"react-dom": "latest",
		"zustand": "latest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@types/bun": "^1.3.14",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
